{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blindvision.media/schemas/finding.schema.json",
  "title": "Blind Vision Agent Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "severity",
    "category",
    "evidence",
    "affected",
    "scenario",
    "impact",
    "recommendation",
    "validation",
    "status"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "category": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "reference"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["file", "commit", "pull_request", "issue", "test", "workflow", "command", "runtime"]
          },
          "reference": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" }
        }
      }
    },
    "affected": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "scenario": { "type": "string", "minLength": 1 },
    "impact": { "type": "string", "minLength": 1 },
    "recommendation": { "type": "string", "minLength": 1 },
    "validation": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["open", "accepted_risk", "in_progress", "fixed", "verified", "not_applicable"]
    },
    "owner": { "type": "string" },
    "issue": { "type": ["string", "null"] },
    "pull_request": { "type": ["string", "null"] },
    "notes": { "type": "string" }
  }
}
